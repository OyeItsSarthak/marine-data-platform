# ==============================================================================
# Triton Oceanic AI - Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL with automatic SQLite fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marine_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ------------------------------------------------------------------------------
# Real-Time Marine & Oceanographic Data Feeds
# ------------------------------------------------------------------------------
# 1. Open-Meteo Marine API (Waves, Currents, Sea State)
#    - Free tier: NO API KEY NEEDED (Works out of the box!)
#    - Commercial / High-Rate Tier (Optional): https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# 2. Global Fishing Watch (GFW) - Live Commercial AIS Vessel Tracking
#    - Free research API token: https://globalfishingwatch.org/our-apis/
GLOBAL_FISHING_WATCH_API_KEY=

# 3. Copernicus Marine Service (CMEMS) - Sentinel Satellite Grids
#    - Free registration: https://marine.copernicus.eu/
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ------------------------------------------------------------------------------
# GenAI Marine Copilot Cloud LLM Keys (Optional)
# ------------------------------------------------------------------------------
# The platform includes a built-in expert marine reasoning engine.
# 3. Google Gemini Generative Language API (Real-Time Marine LLM)
#    - Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
